{
  "manifest_version": 3,
  "name": "DeepSafe - Scam Ad Blocker",
  "short_name": "DeepSafe",
  "version": "0.2.0",
  "description": "Hides the website sections where deepfake scam ads live, and blocks known scam destinations.",
  "minimum_chrome_version": "121",

  "permissions": [
    "declarativeNetRequest",
    "storage",
    "tabs",
    "alarms",
    "contextMenus"
  ],

  "host_permissions": [
    "<all_urls>",
    "https://sift-steel.vercel.app/*",
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "DeepSafe",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "scam_destinations",
        "enabled": true,
        "path": "rules/scams.json"
      }
    ]
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.facebook.com/*",
        "*://*.instagram.com/*",
        "*://*.tiktok.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*"
      ],
      "js": ["shared/sections.js", "content/engine.js"],
      "css": ["content/engine.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/page-scorer.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/image-shield.js"],
      "css": ["content/image-shield.css"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "blocked/blocked.html",
        "blocked/blocked.css",
        "blocked/blocked.js",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
